NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins, e.g.
# https://app.example.com,https://admin.example.com
# Leave unset only for local development — the backend will restrict requests
# to the four local ROZZI frontend origins. Production requires this allowlist.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Payments
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Maps
MAPS_PROVIDER=google
MAPS_API_KEY=

# Storage: S3-compatible object storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=rozzi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Notifications

# Authentication / verification
CUSTOMER_APP_URL=http://localhost:3002
REQUIRE_ACCOUNT_VERIFICATION=false

# Notifications: console or real provider
NOTIFICATION_EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Rozzi

AUTH_REFRESH_COOKIE_NAME=rozzi_admin_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

// ==========================================================================
// PHASE 1 SCHEMA — Auth + Location architecture
// Later phases (vendors, products, orders, payments, delivery, ledger) will
// extend this file. Kept in one file for now (modular monolith, single DB).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// AUTH / USERS
// --------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
}

enum SurgeLevel {
  NORMAL
  SLIGHTLY_HIGH
  HIGH
  VERY_HIGH
}

enum VendorStaffRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  INVENTORY_MANAGER
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  VENDOR_ADMIN
  RIDER_ADMIN
  SUPPORT_ADMIN
  CONTENT_ADMIN
}

model User {
  id                              String     @id @default(uuid())
  email                           String?    @unique
  phone                           String?    @unique
  referralCode                    String?    @unique
  passwordHash                    String
  fullName                        String
  role                            UserRole
  adminRole                       AdminRole?
  isEmailVerified                 Boolean    @default(false)
  isPhoneVerified                 Boolean    @default(false)
  isActive                        Boolean    @default(true)
  marketingNotificationsEnabled   Boolean    @default(true)
  orderNotificationsEnabled       Boolean    @default(true)
  promotionalNotificationsEnabled Boolean    @default(true)
  createdAt                       DateTime   @default(now())
  updatedAt                       DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  stockMovements          StockMovement[]
  vendor                  Vendor?
  cart                    Cart?
  addresses               Address[]
  orders                  Order[]                  @relation("CustomerOrders")
  rider                   Rider?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  reviewsGiven            Review[]                 @relation("ReviewCustomer")
  supportTickets          SupportTicket[]
  passwordResetTokens     PasswordResetToken[]
  verificationTokens      VerificationToken[]
  vendorStaffMemberships  VendorStaffMember[]
  wallet                  Wallet?
  favoriteVendors         FavoriteVendor[]
  favoriteProducts        FavoriteProduct[]
  walletTransactions      WalletTransaction[]
  promotionRedemptions    PromotionRedemption[]
  walletWithdrawals       WalletWithdrawal[]
  referralsMade           Referral[]               @relation("ReferralReferrer")
  referralReceived        Referral?                @relation("ReferralReferredUser")
  referralRewards         ReferralReward[]         @relation("ReferralRewardReferrer")
  referralCreditAccount   ReferralCreditAccount?
  referralRiskEvents      ReferralRiskEvent[]      @relation("ReferralRiskUser")
  ReferralCreditLedger    ReferralCreditLedger[]

  @@index([role])
  @@map("users")
}

enum ReferralStatus {
  PENDING
  REGISTERED
  FIRST_TRANSACTION
  QUALIFIED
  DELIVERED
  VERIFIED
  REWARDED
  CLOSED
  CANCELLED
  REFUNDED
  REVERSED
  FRAUD_DETECTED
  DISQUALIFIED
}

enum ReferralRiskStatus {
  CLEAR
  REVIEW
  BLOCKED
}

enum ReferralRewardStatus {
  PENDING
  HELD
  AVAILABLE
  REVERSED
  CANCELLED
}

enum ReferralCreditLedgerType {
  CREDIT
  REVERSAL
  ADJUSTMENT
}

model ReferralProgramConfig {
  id                       String   @id @default(uuid())
  isActive                 Boolean  @default(true)
  rewardRatePercent        Decimal  @db.Decimal(5, 2)
  maxRewardAmount          Int // kobo
  minimumTransactionAmount Int // kobo
  holdDurationMinutes      Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([isActive])
  @@map("referral_program_configs")
}

model Referral {
  id             String @id @default(uuid())
  referrerId     String
  referrer       User   @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUserId String @unique
  referredUser   User   @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Restrict)

  status            ReferralStatus @default(PENDING)
  referralCode      String
  attributionSource String?
  attributedAt      DateTime       @default(now())

  // Terms are snapshotted when attribution is finalized so later admin changes
  // only affect new referrals. All monetary values are stored in kobo.
  rewardRatePercent        Decimal @db.Decimal(5, 2)
  maxRewardAmount          Int
  minimumTransactionAmount Int
  holdDurationMinutes      Int

  qualifyingOrderId String?            @unique
  qualifyingOrder   Order?             @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  qualifyingAmount  Int?
  rewardAmount      Int?
  riskStatus        ReferralRiskStatus @default(CLEAR)

  registeredAt DateTime?
  qualifiedAt  DateTime?
  deliveredAt  DateTime?
  verifiedAt   DateTime?
  rewardedAt   DateTime?
  closedAt     DateTime?

  reward     ReferralReward?
  riskEvents ReferralRiskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([status])
  @@index([riskStatus])
  @@index([referralCode])
  @@index([createdAt])
  @@map("referrals")
}

model ReferralReward {
  id                  String                 @id @default(uuid())
  referralId          String                 @unique
  referral            Referral               @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrerId          String
  referrer            User                   @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  amount              Int // kobo
  status              ReferralRewardStatus   @default(PENDING)
  eligibleAt          DateTime?
  holdUntil           DateTime?
  creditedAt          DateTime?
  reversedAt          DateTime?
  reference           String                 @unique
  creditLedgerEntries ReferralCreditLedger[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([referrerId, createdAt])
  @@index([status])
  @@map("referral_rewards")
}

model ReferralCreditAccount {
  id           String                 @id @default(uuid())
  customerId   String                 @unique
  customer     User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance      Int                    @default(0) // ROZZI Credits, kobo-equivalent units
  currency     String                 @default("NGN")
  isActive     Boolean                @default(true)
  transactions ReferralCreditLedger[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@map("referral_credit_accounts")
}

model ReferralCreditLedger {
  id               String                   @id @default(uuid())
  accountId        String
  account          ReferralCreditAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  referralRewardId String?
  referralReward   ReferralReward?          @relation(fields: [referralRewardId], references: [id], onDelete: Restrict)
  type             ReferralCreditLedgerType
  amount           Int // signed: credit positive, reversal/adjustment may be negative
  balanceBefore    Int
  balanceAfter     Int
  reference        String                   @unique
  description      String?
  metadata         Json?
  createdAt        DateTime                 @default(now())

  // A reward can create at most one CREDIT and one REVERSAL ledger entry.
  @@unique([referralRewardId, type])
  @@index([customerId, createdAt])
  @@index([accountId, createdAt])
  @@index([type])
  @@map("referral_credit_ledger")
}

model ReferralRiskEvent {
  id         String             @id @default(uuid())
  referralId String
  referral   Referral           @relation(fields: [referralId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?              @relation("ReferralRiskUser", fields: [userId], references: [id], onDelete: SetNull)
  type       String
  riskStatus ReferralRiskStatus
  reason     String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([referralId, createdAt])
  @@index([userId, createdAt])
  @@index([riskStatus])
  @@map("referral_risk_events")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type, expiresAt])
  @@map("verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// --------------------------------------------------------------------------
// LOCATION ARCHITECTURE
// Generic self-referencing tree: Country -> State -> City -> University(optional)
// -> Campus(optional) -> ServiceArea -> DeliveryZone.
// No location NAME is ever referenced in business logic — only IDs and `type`.
// --------------------------------------------------------------------------

enum LocationType {
  COUNTRY
  STATE
  CITY
  UNIVERSITY
  CAMPUS
  NEIGHBORHOOD
}

model Location {
  id        String       @id @default(uuid())
  parentId  String?
  parent    Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationTree")
  type      LocationType
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  serviceAreas ServiceArea[]

  @@index([parentId])
  @@index([type])
  @@map("locations")
}

enum ServiceAreaStatus {
  DRAFT
  ACTIVE
  PAUSED
  INACTIVE
}

// The operational unit. A vendor, order, or waitlist entry always points
// here — never directly at a raw Location name like "FUTO".
model ServiceArea {
  id                      String            @id @default(uuid())
  locationId              String
  location                Location          @relation(fields: [locationId], references: [id])
  name                    String
  status                  ServiceAreaStatus @default(DRAFT)
  defaultDeliveryRadiusKm Decimal           @default(5) @db.Decimal(6, 2)
  minimumOrderAmount      Int               @default(0) // kobo
  baseDeliveryFee         Int               @default(0) // kobo
  perKmDeliveryFee        Int               @default(0) // kobo
  serviceFeeAmount        Int               @default(0) // kobo, flat; can evolve to % later
  operatingHoursStart     String            @default("08:00")
  operatingHoursEnd       String            @default("23:00")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  deliveryZones   DeliveryZone[]
  waitlist        WaitlistEntry[]
  vendorLocations VendorLocation[]
  orders          Order[]
  riderZones      RiderZone[]
  riderShifts     RiderShift[]
  pricingConfigs  PricingConfig[]

  @@index([locationId])
  @@index([status])
  @@map("service_areas")
}

model PricingConfig {
  id            String      @id @default(uuid())
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  // Service fee — percentage of the net merchandise subtotal after discount.
  serviceFeeRatePercent Decimal @db.Decimal(5, 2)
  serviceFeeCapAmount   Int // kobo

  // Delivery pricing.
  baseDeliveryFee  Int // kobo
  perKmDeliveryFee Int // kobo
  deliveryRadiusKm Decimal @db.Decimal(6, 2)

  riderPayoutRatePercent Decimal @default(92) @db.Decimal(5, 2)

  // Surge pricing. Amounts are fixed kobo charges for the selected level.
  surgeEnabled            Boolean    @default(true)
  surgeLevel              SurgeLevel @default(NORMAL)
  surgeSlightlyHighAmount Int        @default(0) // kobo
  surgeHighAmount         Int        @default(0) // kobo
  surgeVeryHighAmount     Int        @default(0) // kobo
  surgeMaxAmount          Int        @default(0) // kobo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([serviceAreaId])
  @@index([serviceAreaId, isActive])
  @@map("pricing_configs")
}

model DeliveryZone {
  id                  String      @id @default(uuid())
  serviceAreaId       String
  serviceArea         ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  name                String
  isActive            Boolean     @default(true)
  radiusKm            Decimal?    @db.Decimal(6, 2)
  polygon             Json? // GeoJSON polygon, optional alt to radius
  deliveryFeeOverride Int? // kobo, null = use service area default
  maxDistanceKm       Decimal?    @db.Decimal(6, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  orders Order[]

  @@index([serviceAreaId])
  @@map("delivery_zones")
}

// Customers in a not-yet-launched area land here (see spec §4).
model WaitlistEntry {
  id             String       @id @default(uuid())
  phone          String?
  email          String?
  serviceAreaId  String?
  serviceArea    ServiceArea? @relation(fields: [serviceAreaId], references: [id])
  requestedPlace String? // free text if no matching ServiceArea exists yet
  notified       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("waitlist_entries")
}

// --------------------------------------------------------------------------
// AUDIT LOG (used from Phase 1 onward, every admin mutating action)
// --------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// --------------------------------------------------------------------------
// PLATFORM SETTINGS (global, key-value, admin editable — §54)
// --------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ==========================================================================
// PHASE 2 — Categories, Vendors, Products, Cart
// ==========================================================================

// --------------------------------------------------------------------------
// CATEGORIES
// Admin-managed, not hard-coded (§25). Seed data provides Food/Groceries/
// etc, but the schema places no constraint on what categories can exist.
// --------------------------------------------------------------------------

model Category {
  id           String   @id @default(uuid())
  name         String
  iconUrl      String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products                 Product[]
  commissionOverrides      CategoryCommission[]
  VendorCategoryCommission VendorCategoryCommission[]

  @@map("categories")
}

model CommissionConfig {
  id                 String   @id @default(uuid())
  defaultRatePercent Decimal  @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
  @@map("commission_configs")
}

model CategoryCommission {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratePercent Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId])
  @@map("category_commissions")
}

// --------------------------------------------------------------------------
// VENDOR TYPES
// Configurable (§8) — admin can add "Bakery" etc without a code change.
// Seed will create the initial set (Restaurant, Grocery Store, Pharmacy...).
// --------------------------------------------------------------------------

model VendorType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendors Vendor[]

  @@map("vendor_types")
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

enum VendorVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum VendorDocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DeliveryModel {
  PLATFORM_DELIVERY // Model A
  SELF_DELIVERY // Model B
  CUSTOMER_PICKUP // Model C
}

model Vendor {
  id                            String          @id @default(uuid())
  ownerUserId                   String          @unique
  owner                         User            @relation(fields: [ownerUserId], references: [id])
  vendorTypeId                  String
  vendorType                    VendorType      @relation(fields: [vendorTypeId], references: [id])
  storeName                     String
  logoUrl                       String?
  coverImageUrl                 String?
  description                   String?
  phone                         String?
  email                         String?
  status                        VendorStatus    @default(PENDING)
  isOpen                        Boolean         @default(false) // manual open/closed toggle, independent of approval status
  operatingHoursStart           String?
  operatingHoursEnd             String?
  operatingHoursJson            Json?
  temporaryClosureUntil         DateTime?
  holidayMode                   Boolean         @default(false)
  busyMode                      Boolean         @default(false)
  busyPreparationTimeMinutes    Int?
  deliveryRadiusKm              Decimal?        @db.Decimal(6, 2)
  minimumOrderAmount            Int? // kobo
  averagePreparationTimeMinutes Int?
  maxOrdersPerHour              Int? // optional vendor capacity limit; null = unlimited
  commissionRate                Decimal         @default(8) @db.Decimal(5, 2) // percent; admin-configurable per vendor
  supportedDeliveryModels       DeliveryModel[] @default([PLATFORM_DELIVERY])
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  locations                   VendorLocation[]
  outlets                     Outlet[]
  products                    Product[]
  categories                  VendorCategory[]
  commissionOverrides         VendorCommission[]
  categoryCommissionOverrides VendorCategoryCommission[]
  documents                   VendorDocument[]
  verification                VendorVerification?
  carts                       Cart[]
  orders                      Order[]
  reviews                     Review[]                    @relation("ReviewVendor")
  promotions                  Promotion[]
  advertisingCampaigns        VendorAdvertisingCampaign[]
  paymentAccount              VendorPaymentAccount?
  payouts                     VendorPayout[]
  staffMembers                VendorStaffMember[]
  staffInvitations            VendorStaffInvitation[]
  menuSchedules               VendorMenuSchedule[]
  supportTickets              SupportTicket[]             @relation("VendorSupportTickets")
  favoriteCustomers           FavoriteVendor[]

  @@index([status])
  @@index([vendorTypeId])
  @@map("vendors")
}

model VendorCommission {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ratePercent Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorId])
  @@map("vendor_commissions")
}

model VendorCategoryCommission {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratePercent Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorId, categoryId])
  @@index([categoryId])
  @@map("vendor_category_commissions")
}

model VendorStaffMember {
  id        String          @id @default(uuid())
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      VendorStaffRole @default(MANAGER)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([vendorId, userId])
  @@index([vendorId, role, isActive])
  @@index([userId, isActive])
  @@map("vendor_staff_members")
}

model VendorStaffInvitation {
  id         String          @id @default(uuid())
  vendorId   String
  vendor     Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fullName   String
  email      String?
  phone      String?
  role       VendorStaffRole @default(MANAGER)
  tokenHash  String          @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([vendorId, createdAt])
  @@index([expiresAt, acceptedAt])
  @@map("vendor_staff_invitations")
}

model Outlet {
  id                            String                      @id @default(uuid())
  vendorId                      String
  vendor                        Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                          String
  address                       String?
  phone                         String?
  email                         String?
  latitude                      Decimal?                    @db.Decimal(10, 7)
  longitude                     Decimal?                    @db.Decimal(10, 7)
  deliveryRadiusKm              Decimal?                    @db.Decimal(6, 2)
  minimumOrderAmount            Int?
  averagePreparationTimeMinutes Int?
  isActive                      Boolean                     @default(true)
  isOpen                        Boolean                     @default(false)
  operatingHoursJson            Json?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  hours                         OutletHour[]
  products                      OutletProduct[]
  advertisingCampaigns          VendorAdvertisingCampaign[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
  @@map("outlets")
}

model OutletHour {
  id        String  @id @default(uuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)

  @@unique([outletId, dayOfWeek])
  @@map("outlet_hours")
}

model OutletProduct {
  outletId  String
  productId String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@id([outletId, productId])
  @@index([productId])
  @@map("outlet_products")
}

// A vendor can serve one or more service areas (§44).
model VendorLocation {
  id            String      @id @default(uuid())
  vendorId      String
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id])
  address       String?
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  createdAt     DateTime    @default(now())

  @@unique([vendorId, serviceAreaId])
  @@index([serviceAreaId])
  @@map("vendor_locations")
}

model VendorDocument {
  id              String               @id @default(uuid())
  vendorId        String
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  docType         String
  fileUrl         String
  status          VendorDocumentStatus @default(PENDING)
  verified        Boolean              @default(false)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  uploadedAt      DateTime             @default(now())

  @@index([vendorId, status])
  @@index([vendorId, docType])
  @@map("vendor_documents")
}

model VendorVerification {
  id              String                   @id @default(uuid())
  vendorId        String                   @unique
  vendor          Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status          VendorVerificationStatus @default(NOT_STARTED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  adminNote       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, updatedAt])
  @@map("vendor_verifications")
}

// --------------------------------------------------------------------------
// VENDOR CATEGORIES
// Vendor-owned catalogue organization. These are intentionally separate from
// the global marketplace Category managed by admins. A product may therefore
// have one global marketplace category and one vendor-facing category.
// --------------------------------------------------------------------------

model VendorCategory {
  id                    String   @id @default(uuid())
  vendorId              String
  vendor                Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                  String
  imageUrl              String?
  displayOrder          Int      @default(0)
  isActive              Boolean  @default(true)
  availabilityStartTime String?
  availabilityEndTime   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  products Product[]

  @@unique([vendorId, name])
  @@index([vendorId, displayOrder])
  @@map("vendor_categories")
}

// --------------------------------------------------------------------------
// PRODUCTS
// --------------------------------------------------------------------------

model Product {
  id                     String          @id @default(uuid())
  vendorId               String
  vendor                 Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId             String
  category               Category        @relation(fields: [categoryId], references: [id])
  vendorCategoryId       String?
  vendorCategory         VendorCategory? @relation(fields: [vendorCategoryId], references: [id], onDelete: SetNull)
  name                   String
  description            String?
  sku                    String?
  priceAmount            Int // kobo
  discountAmount         Int? // kobo, null = no discount
  unit                   String? // e.g. "piece", "pack", "kg"
  weightGrams            Int?
  isAvailable            Boolean         @default(true)
  preparationTimeMinutes Int?
  availabilityStartTime  String? // HH:mm, recurring daily window
  availabilityEndTime    String? // HH:mm, recurring daily window
  availabilityDays       Int[]           @default([]) // 0=Sunday ... 6=Saturday; empty = every day
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  images               ProductImage[]
  variants             ProductVariant[]
  outlets              OutletProduct[]
  optionGroups         ProductOptionGroup[]
  inventory            Inventory?
  cartItems            CartItem[]
  reviews              Review[]
  favoriteCustomers    FavoriteProduct[]
  menuScheduleItems    VendorMenuScheduleItem[]
  advertisingCampaigns VendorAdvertisingCampaignProduct[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([vendorCategoryId])
  @@map("products")
}

model VendorMenuSchedule {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  startTime String
  endTime   String
  days      Int[]    @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items VendorMenuScheduleItem[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
  @@map("vendor_menu_schedules")
}

model VendorMenuScheduleItem {
  id           String             @id @default(uuid())
  scheduleId   String
  schedule     VendorMenuSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int                @default(0)

  @@unique([scheduleId, productId])
  @@index([scheduleId, displayOrder])
  @@map("vendor_menu_schedule_items")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("product_images")
}

// e.g. size/flavor variants. Each variant can override price; stock is
// still tracked at the Inventory level, keyed by product OR variant.
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "Large", "Chicken flavor"
  priceOverride Int? // kobo, null = use product price
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  inventory Inventory?
  cartItems CartItem[]

  @@index([productId, displayOrder])
  @@map("product_variants")
}

// One row per sellable unit (product, or product+variant). Stock changes
// go through StockService using a DB transaction + row lock (see §41) —
// never a plain read-then-write from application code.
// Product customization groups and selectable option items.
// Category-agnostic: works for food extras, grocery choices, gadget accessories,
// clothing attributes, bundles, and other marketplace products.
model ProductOptionGroup {
  id                    String   @id @default(uuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                  String
  isRequired            Boolean  @default(false)
  minSelections         Int      @default(0)
  maxSelections         Int      @default(1)
  isActive              Boolean  @default(true)
  availabilityStartTime String?
  availabilityEndTime   String?
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items           ProductOptionItem[]
  cartItemOptions CartItemOption[]

  @@index([productId, displayOrder])
  @@map("product_option_groups")
}

model ProductOptionItem {
  id                String             @id @default(uuid())
  groupId           String
  group             ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name              String
  additionalPrice   Int                @default(0) // kobo
  isAvailable       Boolean            @default(true)
  stockQuantity     Int?
  lowStockThreshold Int?
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cartItemOptions   CartItemOption[]

  @@index([groupId, displayOrder])
  @@map("product_option_items")
}

model Inventory {
  id                String          @id @default(uuid())
  productId         String?         @unique
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  lowStockThreshold Int             @default(10)
  updatedAt         DateTime        @updatedAt

  movements StockMovement[]

  @@map("inventory")
}

model StockMovement {
  id             String    @id @default(uuid())
  inventoryId    String
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  reason         String
  referenceType  String?
  referenceId    String?
  actorId        String?
  actor          User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([inventoryId, createdAt])
  @@index([actorId, createdAt])
  @@map("stock_movements")
}

// --------------------------------------------------------------------------
// CART
// MVP rule (§42): one vendor per cart. Enforced in CartService, not just
// in the UI — adding a product from a different vendor clears/rejects
// rather than silently mixing vendors.
// --------------------------------------------------------------------------

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   User     @relation(fields: [customerId], references: [id])
  vendorId   String? // null until the first item is added
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String           @id @default(uuid())
  cartId           String
  cart             Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int
  note             String?
  configurationKey String           @default("")
  optionSelections CartItemOption[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Includes variant + sorted option item IDs, allowing the same product to
  // appear as separate lines when customers choose different configurations.
  @@unique([cartId, productId, configurationKey])
  @@index([cartId])
  @@map("cart_items")
}

model CartItemOption {
  id                      String             @id @default(uuid())
  cartItemId              String
  cartItem                CartItem           @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  groupId                 String
  group                   ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  optionItemId            String
  optionItem              ProductOptionItem  @relation(fields: [optionItemId], references: [id], onDelete: Cascade)
  groupNameSnapshot       String
  optionNameSnapshot      String
  additionalPriceSnapshot Int
  createdAt               DateTime           @default(now())

  @@unique([cartItemId, optionItemId])
  @@index([cartItemId])
  @@index([optionItemId])
  @@map("cart_item_options")
}

// ==========================================================================
// PHASE 4 — Addresses, Orders, Order Lifecycle
// ==========================================================================

// --------------------------------------------------------------------------
// CUSTOMER ADDRESSES (§84)
// --------------------------------------------------------------------------

model Address {
  id           String   @id @default(uuid())
  customerId   String
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String // "Home" / "Hostel" / "School" / "Office" / "Other"
  addressText  String
  landmark     String?
  instructions String? // e.g. "Hostel B, Block 3", "Meet at Main Gate"
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDefault    Boolean  @default(false)

  orders Order[]

  @@index([customerId, isDefault])
  @@map("addresses")
}

// --------------------------------------------------------------------------
// ORDER LIFECYCLE (§14)
// Full status list per spec. Not every transition is reachable yet — rider
// states (RIDER_SEARCHING onward) require the dispatch system built in
// Phase 7. The state machine already validates them so Phase 7 only has to
// call transition(), never invent new logic here.
// --------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PENDING_VENDOR
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_SEARCHING
  RIDER_ASSIGNED
  RIDER_ARRIVED_PICKUP
  PICKED_UP
  IN_TRANSIT
  RIDER_ARRIVED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum OrderDeliveryType {
  DELIVERY
  PICKUP
}

model Order {
  id             String            @id @default(uuid())
  orderNumber    String            @unique // human-facing e.g. VEL-10001
  customerId     String
  customer       User              @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId       String
  vendor         Vendor            @relation(fields: [vendorId], references: [id])
  serviceAreaId  String
  serviceArea    ServiceArea       @relation(fields: [serviceAreaId], references: [id])
  deliveryZoneId String?
  deliveryZone   DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id])
  deliveryType   OrderDeliveryType @default(DELIVERY)
  deliveryModel  DeliveryModel     @default(PLATFORM_DELIVERY)
  scheduledFor   DateTime?
  addressId      String?
  address        Address?          @relation(fields: [addressId], references: [id])

  status OrderStatus @default(PENDING_PAYMENT)

  // Amounts snapshotted in kobo at order-creation time — never recalculated
  // later from "current" prices/fees, so a later admin fee change can't
  // retroactively alter an existing order's total (§93 configurability
  // must apply to NEW orders only, per that section's own example).
  grossMerchandiseAmount Int
  subtotalAmount         Int
  deliveryFeeAmount      Int
  serviceFeeAmount       Int
  surgeFeeAmount         Int            @default(0)
  discountAmount         Int            @default(0)
  totalAmount            Int
  commissionRateSnapshot Decimal        @db.Decimal(5, 2)
  riderPayoutRateSnapshot Decimal?       @db.Decimal(5, 2)
  pricingConfigId        String?
  pricingConfig          PricingConfig? @relation(fields: [pricingConfigId], references: [id], onDelete: SetNull)

  deliveryCode               String? // OTP for delivery confirmation — wired up in Phase 7
  deliveryCodeFailedAttempts Int       @default(0)
  deliveryCodeLockedUntil    DateTime?
  customerNote               String?
  cancelReason               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  delivery              Delivery?
  ledgerEntries         LedgerEntry[]
  refunds               Refund[]
  review                Review?
  tip                   RiderTip?
  riderCashTransactions RiderCashTransaction[]
  promotionId           String?
  promotion             Promotion?             @relation(fields: [promotionId], references: [id])
  promotionCode         String?
  supportTickets        SupportTicket[]
  walletTransactions    WalletTransaction[]
  promotionRedemptions  PromotionRedemption[]
  referral              Referral?

  @@index([customerId])
  @@index([vendorId])
  @@index([serviceAreaId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  variantId String?

  // Snapshots — if the vendor edits the product name/price tomorrow, this
  // order's receipt must still show what the customer actually bought.
  nameSnapshot      String
  unitPriceSnapshot Int
  quantity          Int
  subtotalAmount    Int

  // Commission snapshot — preserves the exact commission
  // that applied when this item was purchased.
  commissionRateSnapshot   Decimal @db.Decimal(5, 2)
  commissionAmountSnapshot Int

  optionSnapshots OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id                      String    @id @default(uuid())
  orderItemId             String
  orderItem               OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupNameSnapshot       String
  optionNameSnapshot      String
  additionalPriceSnapshot Int
  createdAt               DateTime  @default(now())

  @@index([orderItemId])
  @@map("order_item_options")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ==========================================================================
// PHASE 5 — Payments
// Provider-abstracted: PaymentProviderName enum + a Payment/PaymentEvent
// model that doesn't care which provider was used. Adding Flutterwave later
// means writing a new adapter class, not touching this schema.
// ==========================================================================

enum PaymentProviderName {
  PAYSTACK
  FLUTTERWAVE
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

model Payment {
  id                    String              @id @default(uuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id])
  provider              PaymentProviderName
  reference             String              @unique // our reference, sent to the provider and echoed back
  providerTransactionId String? // provider-side transaction identifier (required by Flutterwave verify/refund)
  amount                Int // kobo — must equal order.totalAmount, re-checked at verify time
  currency              String              @default("NGN")
  status                PaymentStatus       @default(PENDING)
  authorizationUrl      String?
  paidAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Every webhook delivery and verify-call result is recorded here — this is
// what makes webhook processing idempotent (§70, §71): a duplicate webhook
// for the same (provider, providerReference, eventType) is rejected by the
// unique constraint before it can double-process a payment.
model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id])
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id])
  amount            Int
  reason            String?
  status            RefundStatus @default(REQUESTED)
  providerReference String?
  requestedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model PaymentEvent {
  id                String              @id @default(uuid())
  paymentId         String
  payment           Payment             @relation(fields: [paymentId], references: [id])
  provider          PaymentProviderName
  providerReference String
  eventType         String // e.g. "charge.success", "manual_verify"
  rawPayload        Json
  createdAt         DateTime            @default(now())

  @@unique([provider, providerReference, eventType])
  @@index([paymentId])
  @@map("payment_events")
}

// ==========================================================================
// PHASE 6 — Riders
// ==========================================================================

// Unlike VendorType/Category (explicitly required to be admin-configurable,
// §8/§25), the spec doesn't ask for vehicle types to be admin-editable, so
// this stays a fixed enum. Revisit as a table if that assumption changes.
enum VehicleType {
  BICYCLE
  MOTORCYCLE
  TRICYCLE
  CAR
  VAN
  ON_FOOT
}

// §11: PENDING -> UNDER_REVIEW -> APPROVED -> ACTIVE -> SUSPENDED.
// Design note (flagging the ambiguity rather than quietly picking one
// reading): the spec lists both APPROVED and ACTIVE as lifecycle states
// without defining the difference from "online/offline". This
// implementation treats APPROVED as "cleared by admin to start working"
// and ACTIVE as "has gone online at least once" — i.e. ACTIVE is set
// automatically the first time an approved rider goes online, rather than
// being a separate admin action. `isOnline` remains a completely separate,
// rider-controlled toggle on top of this. If your actual intent for ACTIVE
// was different (e.g. a distinct admin activation step), this is a one-line
// change in RidersService.goOnline — flagging it now rather than guessing
// silently.
enum RiderStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
}

model Rider {
  id                    String      @id @default(uuid())
  ownerUserId           String      @unique
  owner                 User        @relation(fields: [ownerUserId], references: [id])
  address               String?
  profilePhotoUrl       String?
  vehicleType           VehicleType
  vehiclePlateNumber    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Payout fields: intentionally minimal at this phase — no payout
  // execution exists yet (that's Phase 10, alongside the ledger). Storing
  // these now so onboarding can collect them once and not need a schema
  // change later.
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  status                RiderStatus @default(PENDING)
  rejectionReason       String?
  isOnline              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  documents           RiderDocument[]
  zones               RiderZone[]
  location            RiderLocation?
  deliveries          Delivery[]
  deliveryAttempts    DeliveryAttempt[]
  reviews             Review[]                  @relation("ReviewRider")
  tips                RiderTip[]
  issues              RiderIssue[]
  payouts             RiderPayout[]
  cashTransactions    RiderCashTransaction[]
  achievements        RiderAchievement[]
  bonuses             RiderBonus[]
  challengeProgress   RiderChallengeProgress[]
  referralsSent       RiderReferral[]           @relation("RiderReferralSender")
  shifts              RiderShift[]
  referralReceived    RiderReferral?            @relation("RiderReferralReceiver")
  insurances          RiderInsurance[]
  vehicleMaintenance  RiderVehicleMaintenance[]
  equipment           RiderEquipment[]
  academyProgress     RiderAcademyProgress[]
  sosEvents           RiderSosEvent[]
  financeApplications RiderFinanceApplication[]
  loyalty             RiderLoyalty?
  loyaltyEvents       RiderLoyaltyEvent[]

  @@index([status])
  @@map("riders")
}

model RiderDocument {
  id         String    @id @default(uuid())
  riderId    String
  rider      Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  docType    String // e.g. "drivers_license", "id_card", "vehicle_registration"
  fileUrl    String
  verified   Boolean   @default(false)
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  @@map("rider_documents")
}

// A rider can operate across multiple zones simultaneously (§44: "A rider
// can operate in Zone A + Zone B").
model RiderZone {
  id            String      @id @default(uuid())
  riderId       String
  rider         Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([riderId, serviceAreaId])
  @@index([serviceAreaId])
  @@map("rider_zones")
}

// Live position, updated frequently by the rider app. Kept as its own
// single-row-per-rider table (rather than an append-only log) since Phase 7
// dispatch only ever needs "where is this rider right now" — a location
// history table can be added later if trip replay/auditing needs it.
enum RiderShiftStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  MISSED
}

model RiderShift {
  id            String           @id @default(uuid())
  riderId       String
  rider         Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  serviceAreaId String?
  serviceArea   ServiceArea?     @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  startsAt      DateTime
  endsAt        DateTime
  status        RiderShiftStatus @default(BOOKED)
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([riderId, startsAt])
  @@index([serviceAreaId, startsAt])
  @@index([status, startsAt])
  @@map("rider_shifts")
}

model RiderLocation {
  riderId   String   @id
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  updatedAt DateTime @updatedAt

  @@map("rider_locations")
}

enum RiderInsuranceStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

model RiderInsurance {
  id           String               @id @default(uuid())
  riderId      String
  rider        Rider                @relation(fields: [riderId], references: [id], onDelete: Cascade)
  provider     String
  policyNumber String
  coverageType String
  startDate    DateTime
  expiryDate   DateTime
  documentUrl  String?
  status       RiderInsuranceStatus @default(PENDING)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([riderId, policyNumber])
  @@index([riderId, expiryDate])
  @@index([status, expiryDate])
  @@map("rider_insurances")
}

enum RiderMaintenanceType {
  SERVICE
  OIL_CHANGE
  TYRE
  BRAKE
  REPAIR
  INSPECTION
  OTHER
}

model RiderVehicleMaintenance {
  id          String               @id @default(uuid())
  riderId     String
  rider       Rider                @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type        RiderMaintenanceType
  description String
  odometerKm  Int?
  costAmount  Int?
  serviceDate DateTime
  nextDueDate DateTime?
  nextDueKm   Int?
  receiptUrl  String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([riderId, serviceDate])
  @@index([riderId, nextDueDate])
  @@map("rider_vehicle_maintenance")
}

enum RiderEquipmentStatus {
  REQUESTED
  ISSUED
  RETURNED
  DAMAGED
  LOST
  REPLACEMENT_REQUESTED
}

model RiderEquipment {
  id                     String               @id @default(uuid())
  riderId                String
  rider                  Rider                @relation(fields: [riderId], references: [id], onDelete: Cascade)
  itemType               String
  serialNumber           String?
  status                 RiderEquipmentStatus @default(REQUESTED)
  issuedAt               DateTime?
  returnedAt             DateTime?
  replacementRequestedAt DateTime?
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([riderId, status])
  @@map("rider_equipment")
}

enum RiderAcademyProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model RiderAcademyProgress {
  id           String                     @id @default(uuid())
  riderId      String
  rider        Rider                      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  code         String
  title        String
  description  String
  status       RiderAcademyProgressStatus @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?
  scorePercent Int?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([riderId, code])
  @@index([riderId, status])
  @@map("rider_academy_progress")
}

model RiderSosEvent {
  id          String    @id @default(uuid())
  riderId     String
  rider       Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  status      String    @default("OPEN")
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  notes       String?

  @@index([riderId, triggeredAt])
  @@index([status, triggeredAt])
  @@map("rider_sos_events")
}

// ==========================================================================
// PHASE 7 — Delivery Dispatch
// Order.status remains the single authoritative lifecycle field (via
// OrderStateMachine, Phase 4). Delivery/DeliveryAttempt track the
// dispatch-specific bookkeeping (who was offered, who accepted, distances)
// that sits alongside that lifecycle rather than duplicating it.
// ==========================================================================

enum DeliveryAttemptStatus {
  OFFERED
  ACCEPTED
  DECLINED
  TIMED_OUT
}

model DeliveryGroup {
  id        String   @id @default(uuid())
  status    String   @default("OPEN")
  maxOrders Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@map("delivery_groups")
}

model Delivery {
  id      String         @id @default(uuid())
  orderId String         @unique
  order   Order          @relation(fields: [orderId], references: [id])
  riderId String?
  rider   Rider?         @relation(fields: [riderId], references: [id])
  groupId String?
  group   DeliveryGroup? @relation(fields: [groupId], references: [id])

  // Snapshotted at dispatch time so ranking/history isn't affected by the
  // vendor moving locations later.
  pickupLatitude   Decimal? @db.Decimal(10, 7)
  pickupLongitude  Decimal? @db.Decimal(10, 7)
  dropoffLatitude  Decimal? @db.Decimal(10, 7)
  dropoffLongitude Decimal? @db.Decimal(10, 7)

  attemptCount Int       @default(0)
  assignedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attempts         DeliveryAttempt[]
  issues           RiderIssue[]
  cashTransactions RiderCashTransaction[]
  bonuses          RiderBonus[]
  sosEvents        RiderSosEvent[]

  @@index([riderId])
  @@index([groupId])
  @@map("deliveries")
}

model RiderIssue {
  id          String    @id @default(uuid())
  riderId     String
  rider       Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  category    String
  subject     String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([riderId, status])
  @@index([deliveryId])
  @@map("rider_issues")
}

enum RiderPayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RiderCashTransactionType {
  COLLECTION
  REMITTANCE
  ADJUSTMENT
}

model RiderPayout {
  id                 String            @id @default(uuid())
  riderId            String
  rider              Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount             Int
  status             RiderPayoutStatus @default(REQUESTED)
  reference          String            @unique
  bankName           String?
  accountName        String?
  accountNumberLast4 String?
  ledgerEntryId      String?           @unique
  failureReason      String?
  requestedAt        DateTime          @default(now())
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([riderId, status, createdAt])
  @@index([status])
  @@map("rider_payouts")
}

model RiderCashTransaction {
  id          String                   @id @default(uuid())
  riderId     String
  rider       Rider                    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryId  String?
  delivery    Delivery?                @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)

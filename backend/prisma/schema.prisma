// ==========================================================================
// PHASE 10 — Financial Ledger, Settlements, and Reporting
// ==========================================================================

// §35: "Do not implement financial balances using simple balance = balance
// + amount without an accounting trail." Every entry here is append-only —
// nothing in the codebase ever UPDATEs or DELETEs a LedgerEntry. A
// vendor/rider/platform "balance" is always DERIVED by summing entries at
// query time (see LedgerService), never stored as a mutable column.
//
// HONESTY FLAG on scope: this is a single-entry ledger (each entry credits
// or debits ONE account), not full double-entry bookkeeping (where every
// entry has a matching opposite entry so the books always balance to
// zero). Single-entry is enough to answer "what does the platform owe
// vendor X" and produce an audit trail per §35–36, but a real accounting
// system for tax/financial-statement purposes would want proper
// double-entry. Flagging this now rather than presenting it as more rigorous
// than it is.
enum LedgerEntryType {
  CUSTOMER_PAYMENT
  VENDOR_EARNING
  PLATFORM_COMMISSION
  RIDER_EARNING
  REFUND
  PAYOUT
  ADJUSTMENT
  PROMOTION
  PAYMENT_FEE
}

enum LedgerAccountType {
  PLATFORM
  VENDOR
  RIDER
  CUSTOMER
}

enum VendorPaymentAccountStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum VendorPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model VendorPaymentAccount {
  id                 String                     @id @default(uuid())
  vendorId           String                     @unique
  vendor             Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bankName           String
  bankCode           String?
  accountName        String
  accountNumberLast4 String
  providerAccountId  String?
  payoutMethod       String                     @default("BANK_TRANSFER")
  status             VendorPaymentAccountStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@map("vendor_payment_accounts")
}

model VendorPayout {
  id                 String             @id @default(uuid())
  vendorId           String
  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount             Int
  status             VendorPayoutStatus @default(PENDING)
  reference          String             @unique
  bankName           String?
  accountName        String?
  accountNumberLast4 String?
  ledgerEntryId      String?            @unique
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([vendorId, createdAt])
  @@index([status])
  @@map("vendor_payouts")
}

model LedgerEntry {
  id             String            @id @default(uuid())
  type           LedgerEntryType
  accountType    LedgerAccountType
  // Null when accountType is PLATFORM (the platform doesn't need a foreign
  // key to itself). Points at a Vendor.id or Rider.id otherwise —
  // deliberately not a Prisma relation, since the target table depends on
  // accountType; application code is responsible for interpreting it
  // alongside accountType, same tradeoff as `Order.deliveryCode` needing no
  // relation.
  accountId      String?
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id])
  // Signed: positive increases the account's balance, negative decreases
  // it. A PAYOUT entry is negative (money leaving the vendor/rider's
  // pending balance because it's been paid out).
  amount         Int
  description    String?
  // Stable idempotency key for externally-triggered/event-driven bookings.
  // Nullable so manual adjustments can still be recorded without one.
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([accountType, accountId])
  @@index([orderId])
  @@index([type])
  @@map("ledger_entries")
}

// --------------------------------------------------------------------------
// CUSTOMER WALLET & PROMOTION REDEMPTIONS
// --------------------------------------------------------------------------
enum WalletTransactionType {
  TOP_UP
  ORDER_PAYMENT
  REFUND
  PROMOTIONAL_CREDIT
  CASHBACK
  REFERRAL_REWARD
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum WalletWithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

model Wallet {
  id           String              @id @default(uuid())
  customerId   String              @unique
  customer     User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0)
  currency     String              @default("NGN")
  isActive     Boolean             @default(true)
  transactions WalletTransaction[]
  withdrawals  WalletWithdrawal[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  wallet        Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          WalletTransactionType
  status        WalletTransactionStatus @default(PENDING)
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String                  @unique
  description   String?
  metadata      Json?
  createdAt     DateTime                @default(now())

  @@index([customerId, createdAt])
  @@index([walletId, createdAt])
  @@index([orderId])
  @@map("wallet_transactions")
}

model WalletWithdrawal {
  id                 String                 @id @default(uuid())
  walletId           String
  wallet             Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount             Int
  status             WalletWithdrawalStatus @default(REQUESTED)
  bankName           String
  accountName        String
  accountNumberLast4 String
  reference          String                 @unique
  reason             String?
  processedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
  @@map("wallet_withdrawals")
}

model PromotionRedemption {
  id             String    @id @default(uuid())
  promotionId    String
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  discountAmount Int
  redeemedAt     DateTime  @default(now())

  @@unique([promotionId, customerId, orderId])
  @@index([promotionId, customerId])
  @@index([customerId, redeemedAt])
  @@index([orderId])
  @@map("promotion_redemptions")
}

// ==========================================================================
// PHASE 13 — Reviews, Promotions, Support, CMS
// ==========================================================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id               String        @id @default(uuid())
  code             String        @unique
  name             String
  type             PromotionType
  value            Int
  minOrderAmount   Int           @default(0)
  maxDiscount      Int?
  usageLimit       Int?
  usageCount       Int           @default(0)
  perCustomerLimit Int?
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orders      Order[]
  redemptions PromotionRedemption[]
  vendorId    String?
  vendor      Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([vendorId, isActive, startsAt, endsAt])
  @@index([code])
  @@map("promotions")
}

model FavoriteVendor {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, vendorId])
  @@index([customerId, createdAt])
  @@index([vendorId])
  @@map("favorite_vendors")
}

model FavoriteProduct {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
  @@map("favorite_products")
}

model Review {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User      @relation("ReviewCustomer", fields: [customerId], references: [id])
  vendorId          String
  vendor            Vendor    @relation("ReviewVendor", fields: [vendorId], references: [id])
  riderId           String?
  rider             Rider?    @relation("ReviewRider", fields: [riderId], references: [id])
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id])
  vendorRating      Int?
  riderRating       Int?
  productRating     Int?
  title             String?
  comment           String?
  photoUrls         String[]  @default([])
  vendorResponse    String?
  vendorRespondedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId])
  @@index([riderId])
  @@index([productId])
  @@map("reviews")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String              @id @default(uuid())
  customerId  String?
  customer    User?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?             @relation("VendorSupportTickets", fields: [vendorId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id])
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages SupportMessage[]

  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([orderId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model ContentBlock {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String?
  body        Json
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([isPublished, sortOrder])
  @@map("content_blocks")
}

// Phase 13 hardening: media is stored in S3-compatible object storage; the DB stores metadata only.
enum MediaAssetStatus {
  PENDING
  UPLOADED
  REJECTED
}

model MediaAsset {
  id        String           @id @default(uuid())
  ownerId   String
  key       String           @unique
  bucket    String
  mimeType  String
  sizeBytes Int
  status    MediaAssetStatus @default(PENDING)
  publicUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([ownerId, status])
  @@map("media_assets")
}

enum VendorAdObjective {
  AWARENESS
  TRAFFIC
  ORDERS
}

model VendorAdvertisingCampaign {
  id            String                             @id @default(uuid())
  vendorId      String
  vendor        Vendor                             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  outletId      String?
  outlet        Outlet?                            @relation(fields: [outletId], references: [id], onDelete: SetNull)
  name          String
  objective     VendorAdObjective                  @default(ORDERS)
  status        String                             @default("DRAFT")
  budgetAmount  Int
  spendAmount   Int                                @default(0)
  impressions   Int                                @default(0)
  clicks        Int                                @default(0)
  conversions   Int                                @default(0)
  revenueAmount Int                                @default(0)
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @updatedAt
  products      VendorAdvertisingCampaignProduct[]

  @@index([vendorId, status, startsAt, endsAt])
  @@index([outletId])
  @@map("vendor_advertising_campaigns")
}

model VendorAdvertisingCampaignProduct {
  campaignId String
  productId  String
  campaign   VendorAdvertisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
  @@map("vendor_advertising_campaign_products")
}

model Advertisement {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  targetUrl    String?
  placement    String
  startsAt     DateTime
  endsAt       DateTime
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([placement, isActive, startsAt, endsAt])
  @@map("advertisements")
}

model Banner {
  id             String   @id @default(uuid())
  title          String
  imageUrl       String
  mobileImageUrl String?
  targetUrl      String?
  placement      String
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([placement, isActive, startsAt, endsAt])
  @@map("banners")
}

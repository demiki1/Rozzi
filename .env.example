# Used by docker-compose.yml at the repo root. Copy to .env before running
# `docker compose up`. This is NOT the same file as backend/.env.example —
# that one is for running the backend directly with `npm run start:dev`
# outside Docker.

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Paystack test-mode keys (sk_test_... / pk_test_...). Leave blank to run
# without payments — payment endpoints will fail with a clear
# "awaiting Paystack credentials" error rather than a fake success (see
# backend's PaystackAdapter).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Build-time URL the admin frontend's browser bundle will call. Must be
# reachable from wherever the admin app's USERS' browsers run — not just
# from inside the Docker network. For local dev, http://localhost:4000 is
# correct because the backend also publishes port 4000 to the host.
ADMIN_API_URL=http://localhost:4000
CUSTOMER_API_URL=http://localhost:4000
VENDOR_API_URL=http://localhost:4000
RIDER_API_URL=http://localhost:4000
CUSTOMER_APP_URL=http://localhost:3002
REQUIRE_ACCOUNT_VERIFICATION=false
PAYMENT_PROVIDER=PAYSTACK
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
NOTIFICATION_EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Rozzi
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=rozzi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

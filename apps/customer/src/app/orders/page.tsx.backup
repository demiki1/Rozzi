'use client';import {useEffect,useState} from 'react';import Link from 'next/link';import {api} from '../../lib/api';import {onOrderStatus} from '../../lib/realtime';export default function Orders(){const [items,setItems]=useState<any[]>([]),[error,setError]=useState('');useEffect(()=>{const load=()=>api('/api/orders/mine').then(setItems).catch(e=>setError(e.message));load();const off=onOrderStatus(()=>{void load()});return off},[]);return <main className="shell"><nav className="nav"><Link className="brand" href="/">ROZZI</Link><Link href="/">Marketplace</Link></nav><h1>My orders</h1>{error&&<div className="error">{error}</div>}{items.map(o=><Link className="card row" href={`/orders/${o.id}`} key={o.id}><div style={{flex:1}}><b>{o.orderNumber}</b><div className="muted">{o.status} · {o.deliveryType}</div></div><strong>₦{((o.totalAmount||0)/100).toLocaleString()}</strong></Link>)}</main>}

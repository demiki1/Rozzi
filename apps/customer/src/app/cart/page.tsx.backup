'use client';import {useEffect,useState} from 'react';import Link from 'next/link';import {api,patch,post} from '../../lib/api';
export default function Cart(){const [cart,setCart]=useState<any>(),[error,setError]=useState('');async function load(){try{setCart(await api('/api/cart'))}catch(e:any){setError(e.message)}}useEffect(()=>{load()},[]);const items=cart?.items||[];return <main className="shell"><nav className="nav"><Link className="brand" href="/">ROZZI</Link><Link href="/">Continue shopping</Link></nav><h1>Your cart</h1>{error&&<div className="error">{error}</div>}{!items.length?<div className="card">Your cart is empty.</div>:<>{items.map((x:any)=><div className="card row" key={x.id}><div style={{flex:1}}><b>{x.product?.name}</b><div className="muted">₦{((x.unitPriceAmount||x.product?.priceAmount||0)/100).toLocaleString()}</div></div><input className="input" style={{width:90}} type="number" min={1} value={x.quantity} onChange={async e=>{await patch(`/api/cart/items/${x.id}`,{quantity:Number(e.target.value)});load()}}/><button className="btn secondary" onClick={async()=>{await fetch(`${process.env.NEXT_PUBLIC_API_URL||'http://localhost:4000'}/api/cart/items/${x.id}`,{method:'DELETE',headers:{Authorization:`Bearer ${localStorage.getItem('rozzi_token')}`}});load()}}>Remove</button></div>)}<Link className="btn" href="/checkout">Checkout</Link></>}</main>}


'use client';
import Link from 'next/link';import {useEffect,useState} from 'react';import {api,post} from '../lib/api';
export default function Home(){const [banners,setBanners]=useState<any[]>([]),[areas,setAreas]=useState<any[]>([]),[cats,setCats]=useState<any[]>([]),[products,setProducts]=useState<any[]>([]),[q,setQ]=useState(''),[area,setArea]=useState(''),[err,setErr]=useState('');useEffect(()=>{Promise.all([api('/api/advertising/banners/HOME'),api('/api/service-areas'),api('/api/categories'),api('/api/products')]).then(([b,a,c,p])=>{setBanners(b);setAreas(a);setCats(c);setProducts(p.items ?? [])}).catch(e=>setErr(e.message))},[]);async function search(){try{const result = await api('/api/products?' + new URLSearchParams({search:q,...(area?{serviceAreaId:area}:{})} as any).toString()); setProducts(result.items ?? [])}catch(e:any){setErr(e.message)}}return <><nav className="nav"><Link className="brand" href="/">ROZZI</Link><div className="navlinks"><Link href="/cart">Cart</Link><Link href="/orders">Orders</Link><Link href="/notifications">Notifications</Link><Link href="/login">Login</Link><Link href="/support">Support</Link></div></nav><main className="shell">{banners.length>0&&<section className="hero"><div className="row">{banners.map(b=><a key={b.id} href={b.targetUrl||'#'}><img src={b.imageUrl} alt={b.title} style={{maxWidth:'100%',borderRadius:16}} /></a>)}</div></section>}<section className="hero"><span className="tag">Nigeria-first marketplace</span><h1>Everything you need, delivered locally.</h1><p className="muted">Food, groceries, essentials, health products, gadgets and more.</p><div className="row"><select className="input" style={{maxWidth:280}} value={area} onChange={e=>setArea(e.target.value)}><option value="">Choose delivery area</option>{areas.map(a=><option key={a.id} value={a.id}>{a.name}</option>)}</select><input className="input" style={{maxWidth:420}} placeholder="Search food, groceries, gadgets..." value={q} onChange={e=>setQ(e.target.value)} onKeyDown={e=>e.key==='Enter'&&search()}/><button className="btn" onClick={search}>Search</button></div></section>{err&&<div className="error">{err}</div>}<h2>Categories</h2><div className="row">{cats.map(c=><span className="tag" key={c.id}>{c.name}</span>)}</div><h2>Products</h2><div className="grid grid3">{products.map(p=><div className="card" key={p.id}><span className="tag">{p.category?.name||'Marketplace'}</span><h3>{p.name}</h3><p className="muted">{p.description||'Quality product from a local vendor.'}</p><div className="row"><span className="price">₦{((p.discountAmount??p.priceAmount)/100).toLocaleString()}</span><button className="btn success" onClick={async()=>{try{await post('/api/cart/items',{productId:p.id,quantity:1});alert('Added to cart')}catch(e:any){alert(e.message)}}}>Add</button></div></div>)}</div></main></> }
